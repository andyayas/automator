{
  "name": "clinic-admin-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tracked": "sh scripts/check-tracked.sh",
    "check:rls": "tsx --env-file=.env.local scripts/rls-check.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "gen:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "test:integration": "INTEGRATION=1 vitest run src/lib/api.integration.test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-golive.ts",
    "check:names": "tsx scripts/scan-real-names.ts --all",
    "compare:reports": "tsx --env-file=.env.local scripts/compare-reports.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.3",
    "exceljs": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.3",
    "oxlint": "1.81.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
